# CargoClarity local configuration
# Copy to .env locally; never commit the populated file.

APP_ENV=development
DATABASE_URL=sqlite:///./cargoclarity.db
DATA_SOURCE=./data/participant/sdoc-hackathon-bundle

# Optional Phase 3 AI assistance. Leave AI_API_KEY empty for deterministic fallback.
AI_PROVIDER=openai-compatible
AI_API_BASE=
AI_MODEL=gpt-5-mini
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_PROMPT_VERSION=phase3-v1
