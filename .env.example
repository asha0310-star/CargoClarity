# CargoClarity local configuration
# Reference template. The project also has a local .env file for development.
# Never commit the populated local file.

APP_ENV=development
DATABASE_URL=sqlite:///./cargoclarity.db
DATA_SOURCE=./data/participant/sdoc-hackathon-bundle

# Optional Phase 3 AI assistance through Google Gemini Free Tier.
# Leave GEMINI_API_KEY empty for deterministic fallback.
AI_PROVIDER=gemini
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_PROMPT_VERSION=phase3-v1

# API and dashboard settings
API_HOST=127.0.0.1
API_PORT=8000
API_STATE_PATH=.runtime/api_state.json
# Optional in packaged deployments; local editable installs find dashboard/ automatically.
DASHBOARD_DIR=
API_MAX_BODY_BYTES=1048576
API_MUTATION_RATE_LIMIT=60
